<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RootNamespace>OesTest</RootNamespace>
    <AssemblyName>OesTest</AssemblyName>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aqst.OesSpectrometer" Version="0.6.2" />
    <PackageReference Include="OxyPlot.Wpf" Version="2.2.0" />
  </ItemGroup>

  <!--
    The Aqst.OesSpectrometer package ships its native DLLs under runtimes\win-x64\native\,
    but the DllResolver only searches the app base directory. Flatten them into the output
    root so the resolver can find them. libsodium.dll is an import of the 0.4.x
    UserApplication.dll — if it is missing, LoadLibrary fails and the SDK silently falls
    back to test mode, so all three must land side by side.
  -->
  <Target Name="FlattenOesNativeDlls" AfterTargets="Build;Publish">
    <ItemGroup>
      <_OesNative Include="$(OutDir)runtimes\win-x64\native\UserApplication.dll" />
      <_OesNative Include="$(OutDir)runtimes\win-x64\native\SiUSBXp.dll" />
      <_OesNative Include="$(OutDir)runtimes\win-x64\native\libsodium.dll" />
      <_OesNativePub Include="$(PublishDir)runtimes\win-x64\native\UserApplication.dll"
                     Condition="'$(PublishDir)' != ''" />
      <_OesNativePub Include="$(PublishDir)runtimes\win-x64\native\SiUSBXp.dll"
                     Condition="'$(PublishDir)' != ''" />
      <_OesNativePub Include="$(PublishDir)runtimes\win-x64\native\libsodium.dll"
                     Condition="'$(PublishDir)' != ''" />
    </ItemGroup>
    <Copy SourceFiles="@(_OesNative)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('%(_OesNative.FullPath)')" />
    <Copy SourceFiles="@(_OesNativePub)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('%(_OesNativePub.FullPath)')" />
  </Target>

</Project>
